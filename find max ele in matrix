void maximum(int(*a)[10],int*r,int*c){
    int i,j;
    int max,res[20];
    for(i=0;i<*r;i++){
        max=a[i][0];
        for(j=1;j<*c;j++){
            if(a[i][j]>max){
                max=a[i][j];
            }
        
        res[i]=max;
        }
        max=0;
    
    
    }
    printf("maximum element in each row is : \n");
    for(i=0;i<*r;i++){
        printf("row %d : %d\n",i+1,res[i]);
   
}
}
