}

NODE*insertfront(NODE*start,int n){
    NODE*new_node;
    new_node=(NODE*)malloc(sizeof(struct node));
    new_node->data=n;
    new_node->next=start;
    start=new_node;
    return start;
}

NODE*i_pos(NODE*start,int n,int position){
    NODE*new_node,*temp,*ptr;
    int count;
    new_node=(NODE*)malloc(sizeof(struct node));
    new_node->data=n;
    if((start==NULL) && (position==1)){
        new_node->next=NULL;
        start=new_node;
    }
    else if((start == NULL) && (count > 1)){
        printf("Invalid position");
    }
    else{
        count=1;
        ptr=start;
        while((ptr != NULL) && (count != position)){
            temp=ptr;
            ptr=ptr->next;
            count++;
        }
        if(ptr==NULL){
            printf("Invalid position");
        }
        else{
            new_node->next=ptr;
            temp->next=new_node;
        }
    }
    return start;
}
NODE*deletekey(NODE* start,int key){
    NODE*temp,*ptr=start;
    if(start == NULL){
        printf("List empty\n");
        return start;
    }
    else if(start->data == key){
        printf("Item deleted: %d",start->data);
        ptr=start;
        start=start->next;
        free(ptr);
        return start;
    }
    else{
        ptr=start;
        while((ptr != NULL) && (ptr->data != key)){
            temp=ptr;
            ptr=ptr->next;
        }
    }
    if(ptr == NULL){
        printf("Invalid key");
    }
    else{
        temp->next=ptr->next;
        printf("Item deleted: %d\n",ptr->data);
        free(ptr);
    }
    return start;
}
void display(NODE*start){
    NODE*ptr;
    if(start == NULL){
        printf("The List is empty\n");
    
        
    }
    else{
    
      ptr=start;
      printf("The list data are : \n");
      while( ptr != NULL){
         printf("%d\n",ptr->data);
         ptr=ptr->next;
        
        }
    }
}

NODE*Searchkey(NODE*start,int key){
    NODE *ptr;
    if(start == NULL){
        printf("The List is empty\n");
    }
    else{
        ptr=start;
        while((ptr != NULL) && (ptr->data != key)){
            ptr=ptr->next;
        }
        if(ptr == NULL){
            printf("invalid key\n");
        }
        else{
            printf("The key %d found\n",ptr->data);
        }
    }
    return start;
}

NODE*reverselist(NODE* start){
    NODE* prev = NULL,*current=start,*next=NULL;
    while(current != NULL){
        next=current->next;
        current->next=prev;
        prev=current;
        current=next;
    }
    return prev;
}
    

  
    

   
