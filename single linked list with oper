
#include <stdio.h>
#include <stdlib.h>
struct node{
    int data;
    struct node*next;
};
typedef struct node NODE;

NODE*insertfront(NODE*,int);
NODE*Searchkey(NODE*,int);
NODE*i_pos(NODE*,int,int);
NODE*deletekey(NODE*,int);
NODE*reverselist(NODE*);

void display(NODE*);

void main() {
    NODE*start=NULL;
    int num,choic,k,p;
    while(1){
       
        printf("\n1. Insert at Front\n");
        printf("2. Insert at Position\n");
        printf("3. Delete a Node\n");
        printf("4. Searching a Key\n");
        printf("5. Display\n");
        printf("6. Reverse the List\n");
        printf("7. Exit\n");
        printf("Enter your choice : ");
        scanf("%d",&choic);
        switch(choic){
            case 1: printf("Enter data to insert: ");
            scanf("%d",&num);
            start=insertfront(start,num);
            break;
        
            
            case 2: printf("Enter data to insert: ");
                    scanf("%d",&num);
                    printf("Enter the  position data to be insert: ");
                    scanf("%d",&p);
                    start=i_pos(start,num,p);
                    break;
            
            case 3: printf("Enter Key value: ");
                    scanf("%d",&k);
                    start=deletekey(start,k);
                    break;
            
            case 4: printf("Enter key to be searched: ");
                    scanf("%d",&k);
                    start=Searchkey(start,k);
                    break;
            
